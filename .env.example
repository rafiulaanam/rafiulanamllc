# --- Database (Postgres, e.g. Neon/Supabase) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Auth.js (NextAuth) ---
# Generate with: npx auth secret
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Optional — Google OAuth (leave blank to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Stripe ---
# Test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` locally,
# or the signing secret of the endpoint configured in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=""

# --- Transactional email (wired up in a later milestone) ---
RESEND_API_KEY=""

# --- Image hosting (wired up in the Catalog milestone) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Storefront ---
NEXT_PUBLIC_CURRENCY_SYMBOL='$'
