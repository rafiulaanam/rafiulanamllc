generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  member
}

enum InquiryStatus {
  new
  in_progress
  closed
}

enum InquiryKind {
  general
  partnership
  ecommerce
  anamigo_fleet
  anamsoft
  anamcart
}

enum SocialScope {
  company
  ceo
}

model User {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkId     String?       @unique @map("clerk_id")
  displayName String?       @map("display_name")
  disabledAt  DateTime?     @map("disabled_at") @db.Timestamptz(3)
  roles       UserRole[]
  activity    ActivityLog[]
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id   String   @db.Uuid
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([user_id, role])
  @@map("user_roles")
}

model Business {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String      @unique
  name          String
  label         String
  location      String
  description   String
  overview      String
  capabilities  String[]
  image         String
  image_alt     String
  logo          String?
  imageAsset    MediaAsset  @relation("BusinessImage", fields: [image], references: [url], onDelete: Restrict)
  logoAsset     MediaAsset? @relation("BusinessLogo", fields: [logo], references: [url], onDelete: Restrict)
  external_url  String?
  display_order Int         @default(0)
  published     Boolean     @default(true)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([published, display_order, name])
  @@index([image])
  @@index([logo])
  @@map("businesses")
}

model Product {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  slug              String           @unique
  short_description String
  description       String
  image             String?
  image_alt         String           @default("")
  imageAsset        MediaAsset?      @relation(fields: [image], references: [url], onDelete: Restrict)
  category_id       String?          @db.Uuid
  product_categories ProductCategory? @relation(fields: [category_id], references: [id], onDelete: Restrict)
  product_images    ProductImage[]
  amazon_url        String
  price             Decimal?         @db.Decimal(12, 2)
  currency          String           @default("USD") @db.Char(3)
  featured          Boolean          @default(false)
  published         Boolean          @default(false)
  display_order     Int              @default(0)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([category_id])
  @@index([image])
  @@index([published, display_order, name, id])
  @@index([published, featured, display_order, name, id])
  @@map("products")
}

model ProductCategory {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("product_categories")
}

model ProductImage {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id    String     @db.Uuid
  product       Product    @relation(fields: [product_id], references: [id], onDelete: Cascade)
  path          String
  asset         MediaAsset @relation(fields: [path], references: [url], onDelete: Restrict)
  alt           String
  display_order Int        @default(0)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([product_id, path])
  @@index([product_id, display_order])
  @@index([path])
  @@map("product_images")
}

model Inquiry {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String
  company   String?
  kind      InquiryKind
  message   String
  status    InquiryStatus @default(new)
  read_at   DateTime?     @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([updatedAt, id])
  @@map("inquiries")
}

model SiteSetting {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  singleton       Boolean     @unique @default(true)
  company_name    String
  introduction    String
  positioning     String
  brand_logo      String?
  logoAsset       MediaAsset? @relation("SiteBrand", fields: [brand_logo], references: [url], onDelete: Restrict)
  contact_email   String?
  contact_phone   String?
  footer_text     String
  seo_title       String
  seo_description String
  ceo_name        String
  ceo_designation String
  ceo_bio         String
  ceo_vision      String
  ceo_portrait    String?
  portraitAsset   MediaAsset? @relation("SitePortrait", fields: [ceo_portrait], references: [url], onDelete: Restrict)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([brand_logo])
  @@index([ceo_portrait])
  @@map("site_settings")
}

model SocialLink {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope         SocialScope
  label         String
  url           String
  display_order Int         @default(0)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([scope, display_order, label])
  @@map("social_links")
}

model ActivityLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?  @map("resource_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([resource, resourceId, createdAt])
  @@map("activity_logs")
}

model MediaAsset {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url            String         @unique
  cloudinaryId   String?        @unique @map("cloudinary_id")
  width          Int?
  height         Int?
  bytes          Int?
  format         String?
  orphanedAt     DateTime?      @map("orphaned_at") @db.Timestamptz(3)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)
  businessImages Business[]     @relation("BusinessImage")
  businessLogos  Business[]     @relation("BusinessLogo")
  products       Product[]
  productImages  ProductImage[]
  siteLogos      SiteSetting[]  @relation("SiteBrand")
  sitePortraits  SiteSetting[]  @relation("SitePortrait")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([orphanedAt, deletedAt])
  @@map("media_assets")
}

model InquiryRateLimit {
  bucket String
  hour   DateTime @db.Timestamptz(3)
  hits   Int      @default(1)

  @@id([bucket, hour])
  @@index([hour])
  @@map("inquiry_rate_limits")
}
